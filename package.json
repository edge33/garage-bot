{
  "name": "garage-bot",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include-all --test-coverage-exclude='src/index.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts"
  },
  "dependencies": {
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@types/node-fetch": "2.6.13",
    "typescript": "7.0.2"
  }
}
